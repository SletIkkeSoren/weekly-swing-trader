# ============================================================
# Pipeline data directories
# Each stage reads from the previous stage's output directory.
# In k8s these are set per-CronJob; locally, export the right
# pair before running each module:
#
#   Stage 1 — fetcher:   (no INPUT_DIR)   OUTPUT_DIR=/tmp/fetcher
#   Stage 2 — consensus: INPUT_DIR=/tmp/fetcher    OUTPUT_DIR=/tmp/consensus
#   Stage 3 — gate:      INPUT_DIR=/tmp/consensus  OUTPUT_DIR=/tmp/gate
#   Stage 4 — executor:  INPUT_DIR=/tmp/gate       OUTPUT_DIR=/tmp/executor
#
# Example local run:
#   OUTPUT_DIR=/tmp/fetcher python -m fetcher.main
#   INPUT_DIR=/tmp/fetcher OUTPUT_DIR=/tmp/consensus python -m consensus.main
#   INPUT_DIR=/tmp/consensus OUTPUT_DIR=/tmp/gate python -m gate.main
#   INPUT_DIR=/tmp/gate OUTPUT_DIR=/tmp/executor python -m executor.main
# ============================================================

# ── Stage 1: Fetcher ────────────────────────────────────────
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
TICKERS=SPY,QQQ,AAPL,MSFT,NVDA
LOOKBACK_DAYS=252
ALPACA_DATA_FEED=iex            # "iex" (free) or "sip" (paid)

# ── Stage 2: Consensus engine ───────────────────────────────
MISTRAL_API_KEY=your_mistral_key
GOOGLE_API_KEY=your_google_key
OPENAI_API_KEY=your_openai_key
MISTRAL_MODEL=mistral-small-2603
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5-mini

# ── Stage 3: Decision gate ──────────────────────────────────
ACCOUNT_SIZE=2000
MIN_CONFIDENCE=0.65
MIN_AGREEMENT=2
MAX_OPEN_TRADES=3
RISK_PCT=0.01
MAX_CONTRACTS=5           # empty = dry-run (approves nothing, logs proposal)
WEBHOOK_TIMEOUT_SECS=300

# ── Stage 4: Executor ───────────────────────────────────────
ORDER_TYPE=limit                # "limit" or "market"
LIMIT_PRICE_BUFFER=1.05         # pay up to 5% above ask for limit orders
DRY_RUN=false                   # flip to false when ready to place real paper orders
DISCORD_WEBHOOK_URL=            # same Discord webhook URL as gate — posts fill notifications
